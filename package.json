{
  "name": "skydio-autonomy-widget",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "chromatic": "node --env-file-if-exists=.env.local ./node_modules/chromatic/dist/bin.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reportsDirectory=coverage-all-tests",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean-storybook": "rm -rf dist storybook-static node_modules/.vite"
  },
  "dependencies": {
    "framer-motion": "^14.11.1",
    "lodash": "^4.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "chromatic": "^18.14.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.6",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "storybook": "^10.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
